<group name="local,syslog,ssql,">
  <!-- Detect Multiple SQL Server Failed Logins -->
  <rule id="100010" level="10">
    <if_sid>18100</if_sid>
    <match>Login failed for user</match>
    <description>SQL Server: Multiple Authentication Failures Detected</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>
</group>
